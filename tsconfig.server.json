{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "src/features/tasks/lifecycle.ts",
    "src/features/settings/theme.ts",
    "src/features/documents/signoff.ts",
    "src/features/documents/fsd-model.ts",
    "src/features/documents/testcase-model.ts",
    "src/shared/version.ts",
    "src/features/tasks/subtaskAssignment.ts",
    "src/shared/types.ts",
    "src/features/tasks/effort.ts",
    "src/features/tasks/waitingOn.ts",
    "src/features/reports/custom/reportModel.ts"
  ]
}
