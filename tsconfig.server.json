{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "src/lifecycle.ts",
    "src/theme.ts",
    "src/signoff.ts",
    "src/fsd-model.ts",
    "src/testcase-model.ts",
    "src/version.ts",
    "src/subtaskAssignment.ts",
    "src/types.ts",
    "src/effort.ts",
    "src/waitingOn.ts"
  ]
}
