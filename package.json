{
  "name": "ba-client-ops-tracker",
  "private": true,
  "version": "0.6.6",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server.ts --production",
    "preview": "vite preview",
    "patch": "node scripts/apply-patch.mjs",
    "patch:rollback": "node scripts/rollback-patch.mjs",
    "patch:status": "node scripts/patch-status.mjs",
    "test:integrations": "node --import tsx --test tests/integrations.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:accounts": "node --import tsx --test tests/account-users.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.2",
    "discord.js": "^14.22.1",
    "docxtemplater": "latest",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "lucide-react": "latest",
    "nodemailer": "^10.0.10",
    "openai": "^5.20.0",
    "pdf-lib": "latest",
    "pdfjs-dist": "^5.4.149",
    "pizzip": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
