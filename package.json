{
  "name": "ba-client-ops-tracker",
  "private": true,
  "version": "0.6.60",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server.ts --production",
    "preview": "vite preview",
    "patch": "node scripts/apply-patch.mjs",
    "patch:rollback": "node scripts/rollback-patch.mjs",
    "patch:status": "node scripts/patch-status.mjs",
    "test:communications": "node --import tsx --test tests/communications.test.ts",
    "test:integrations": "node --import tsx --test tests/integrations.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:accounts": "node --import tsx --test tests/account-users.test.ts",
    "test:signoff": "node --import tsx --test tests/signoff.test.ts",
    "test:lifecycle": "node --import tsx --test tests/lifecycle.test.ts",
    "test:followups": "node --import tsx --test tests/follow-up-rollover.test.ts",
    "test:notifications": "node --import tsx --test tests/notification-engine.test.ts",
    "test:action-center-scope": "node --import tsx --test tests/action-center-scope.test.ts",
    "test:tenant-save-settings": "node --import tsx --test tests/tenant-save-settings.test.ts",
    "test:calendar": "node --import tsx --test tests/google-calendar.test.ts",
    "test:subtask-assignment": "node --import tsx --test tests/subtask-assignment.test.ts",
    "test:auth-layout": "node --test tests/auth-layout.test.mjs",
    "test:dochub": "node --import tsx --test tests/dochub.test.ts",
    "test:auth-transport": "node --import tsx --test tests/auth-transport.test.ts",
    "test:rtm": "node --import tsx --test tests/rtm.test.ts",
    "test:rtm-ai": "node --import tsx --test tests/rtm-ai.test.ts",
    "db:bundle": "node scripts/build-database-setup.mjs",
    "db:check": "node scripts/build-database-setup.mjs --check",
    "test:fsd-scope": "node --import tsx --test tests/fsd-scope.test.ts",
    "test:functional-integrity": "node --import tsx --test tests/functional-integrity.test.ts",
    "test:functional": "node scripts/test-functional.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.2",
    "discord.js": "^14.22.1",
    "docxtemplater": "latest",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "lucide-react": "latest",
    "nodemailer": "^10.0.10",
    "openai": "^5.20.0",
    "pdf-lib": "latest",
    "pdfjs-dist": "^5.4.149",
    "pizzip": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
