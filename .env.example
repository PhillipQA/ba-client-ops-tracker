# Local app configuration. Copy to .env.local and replace placeholders.
# The app loads .env.local before .env. Keep real credentials outside Git.
DATABASE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Use these instead for an imported/prepared PostgreSQL database.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://app-user:password@database-host:5432/database

# New independent install: generate a key with the command in README.md.
# Existing install: keep the existing key so stored credentials remain readable.
TENANT_INTEGRATION_MASTER_KEY=

# Fresh bootstrap only. Each password must have at least 12 characters.
# Existing accounts use their saved passwords; these do not reset them.
INTERNAL_ADMIN_BOOTSTRAP_PASSWORD=
BXI_CORE_BOOTSTRAP_PASSWORD=
APP_BASE_URL=http://localhost:5173

# Optional. Minutes without activity before a signed-in session ends (default 120). Sessions also end
# 8 hours after sign-in. They are held in server memory, so a restart signs everyone out.
# SESSION_IDLE_TIMEOUT_MINUTES=120
PORT=5173

# Optional business-date timezone; the default is Asia/Manila.
# FOLLOW_UP_TIME_ZONE=Asia/Manila

# Optional public Google Calendar OAuth client ID; provide it during the build.
VITE_GOOGLE_CLIENT_ID=

# Optional SMTP for Forgot password. See docs/setup/password-recovery.md.
# Current DocHub signing reminders use its native API, not SMTP.
# SMTP_HOST=smtp.your-email-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password-or-app-password
# SMTP_FROM="Client Ops Tracker <no-reply@your-verified-domain.example>"

# Configure Discord, DocHub and AI credentials in the app's account settings.
# Database helper scripts load .env by default; for .env.local use
# DOTENV_CONFIG_PATH=.env.local or provide the variables to the process.
