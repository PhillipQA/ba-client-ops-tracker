# Server infrastructure only. Copy to .env.local; never commit real credentials.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# After importing and verifying your Northflank database, switch the app to PostgreSQL.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://app-user:password@northflank-host:5432/database
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TENANT_INTEGRATION_MASTER_KEY=

# Fresh bootstrap only; choose unique values of at least 12 characters.
INTERNAL_ADMIN_BOOTSTRAP_PASSWORD=
BXI_CORE_BOOTSTRAP_PASSWORD=
APP_BASE_URL=http://localhost:5173
PORT=5173

# Optional read-only Google Calendar OAuth public client ID.
VITE_GOOGLE_CLIENT_ID=

# Discord/OpenAI credentials belong in tenant Settings, not this file.
# Existing global provider variables may remain briefly for explicit Internal Admin import.
# SMTP is used by password recovery and DocHub signatory reminder notifications.
# See PASSWORD-RECOVERY-SETUP.md for SMTP configuration.
