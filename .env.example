# OpenAI powers the embedded BA Assistant. Keep this server-side only.
OPENAI_API_KEY=your-openai-api-key
# Balanced default for BA analysis. You can switch to gpt-5.6-sol for harder work
# or gpt-5.6-luna for a lower-cost assistant.
OPENAI_MODEL=gpt-5.6-terra

# Google Calendar remains a browser-side OAuth integration with read-only event access.
# Create an OAuth 2.0 Web application client in Google Cloud, enable the Google Calendar API,
# and add your app origin (local default: http://localhost:5173) as an authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
